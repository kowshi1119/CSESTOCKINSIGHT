<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.csestockinsight"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />
    <!-- Internet permission for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="com.example.csestockinsight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.csestockinsight.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="com.example.csestockinsight.CSEStockInsightApplication"
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="true"
        android:label="CSE Stock Insight"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CSEStockInsight" >
        <activity
            android:name="com.example.csestockinsight.newactivity"
            android:exported="false" />
        <!-- Authentication Entry - New launcher activity -->
        <activity
            android:name="com.example.csestockinsight.AuthEntryActivity"
            android:exported="true"
            android:theme="@style/Theme.CSEStockInsight" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity> <!-- Login Activity -->
        <activity
            android:name="com.example.csestockinsight.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.CSEStockInsight" /> <!-- Register Activity -->
        <activity
            android:name="com.example.csestockinsight.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.CSEStockInsight" /> <!-- Main activity (accessed after login) -->
        <activity
            android:name="com.example.csestockinsight.MainActivity"
            android:exported="false" /> <!-- Fundamental analysis screens -->
        <activity
            android:name="com.example.csestockinsight.FundamentalAnalyzerActivity"
            android:exported="false" />
        <activity
            android:name="com.example.csestockinsight.CompanyDetailActivity"
            android:exported="false" />
        <activity
            android:name="com.example.csestockinsight.FundamentalChartsActivity"
            android:exported="false" /> <!-- Technical analysis screen -->
        <activity
            android:name="com.example.csestockinsight.TechnicalForecastActivity"
            android:exported="false" />

        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:directBootAware="true"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.csestockinsight.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>