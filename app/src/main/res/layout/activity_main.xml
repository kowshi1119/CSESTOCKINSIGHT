<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <!-- App title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textSize="28sp"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:paddingTop="32dp"/>

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Analyze CSE stocks with colourful insights"
        android:textSize="16sp"
        android:textColor="@color/colorOnSurface"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:paddingBottom="32dp"/>

    <!-- Button to open Fundamental Analyzer -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_fundamental"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/fundamental_analyzer"
        android:icon="@android:drawable/ic_menu_search"
        app:iconPadding="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:backgroundTint="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>

    <!-- Button to open Technical Forecast -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_technical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/technical_forecast"
        android:icon="@android:drawable/ic_menu_info_details"
        app:iconPadding="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:backgroundTint="@color/colorSecondary"
        app:layout_constraintTop_toBottomOf="@id/btn_fundamental"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>